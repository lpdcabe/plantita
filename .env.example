# Copy to .env. Use your Supabase project's public publishable (or legacy anon) key.
# Never use a service-role key in VITE_ variables; Vite exposes these to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only: the sole administrator and a Supabase secret or legacy service-role key.
# Never use VITE_ for these values. Required for creating and managing accounts.
ADMIN_EMAIL=lpdcabe@gmail.com
SUPABASE_SECRET_KEY=

# Local Vite development proxies /api to Express. Leave this blank for one-origin production.
VITE_API_URL=
PORT=3001
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
